generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Asset {
  id            String   @id @default(cuid())
  name          String
  category      String
  institution   String?
  value         Float
  investedValue Float    @default(0)
  yieldRate     Float?
  liquidity     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  goal          Goal?
}

model Goal {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String
  priority    String   @default("Média")
  target      Float
  current     Float    @default(0)
  deadline    DateTime?
  status      String   @default("Ativa")
  assetId     String?  @unique
  asset       Asset?   @relation(fields: [assetId], references: [id])
  createdAt   DateTime @default(now())
}

model Transaction {
  id          String   @id @default(cuid())
  type        String
  category    String
  amount      Float
  date        DateTime @default(now())
  note        String?
  recurrent   Boolean  @default(false)
  installment Int?     // número da parcela (1, 2, 3…)
  totalInstallments Int? // total de parcelas do grupo
  installmentGroup String? // cuid compartilhado pelas parcelas
  createdAt   DateTime @default(now())
}

model Budget {
  id        String   @id @default(cuid())
  category  String   @unique
  limit     Float
  createdAt DateTime @default(now())
}

model Profile {
  id        String   @id @default("local-profile")
  name      String   @default("Seu nome")
  level     Int      @default(1)
  xp        Int      @default(0)
  createdAt DateTime @default(now())
}
